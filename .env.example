# MongoDB (single source of truth — replaces the legacy Supabase layer)
MONGODB_URI=mongodb://localhost:27017/relicvault

# Session signing key — JWT (HS256) used by the rv_session httpOnly cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Vision provider selector. Defaults to "zhipu" if unset.
# Options:
#   zhipu        — Zhipu GLM glm-4v-flash (default; China-direct, free)
#   siliconflow  — reserved (not implemented yet)
#   gemini       — deprecated (Google services unreachable from the deployment region)
AI_PROVIDER=zhipu

# Zhipu GLM API key — required when AI_PROVIDER=zhipu.
# Get one at: https://open.bigmodel.cn  →  控制台  →  API Keys
ZHIPU_API_KEY=your-zhipu-api-key
# Optional: override the default model (glm-4v-flash).
# ZHIPU_MODEL=glm-4v-flash

# Public URL of the deployed app (used for canonical links & share metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────
# Legacy keys kept for reference only. NO application code reads them
# — the visual pipeline is fully on Zhipu GLM and storage is fully on
# MongoDB. You may delete these lines.
# ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPENAI_API_KEY=sk-your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key